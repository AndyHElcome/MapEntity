@using MMIv8_Ktype.Models.Collections


@if(Visible)
{
	<DxGridDataColumn FieldName=@GetFieldName(nameof(MatchRefine.BestMatches)) Caption="BestMatches" Visible="false" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(MatchRefine.LastMatches)) Caption="LastMatches" Visible="false" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(MatchRefine.ChosenMatches)) Caption="ChosenMatches" Visible="false" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(MatchRefine.PassCount)) Caption="PassCount" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(MatchRefine.Difference)) Caption="Difference" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(MatchRefine.IsCheck)) Caption="IsCheck" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(MatchRefine.BestScore)) Caption="BestScore" />
}


@code {
	[Parameter] public string Prefix { get; set; } = string.Empty;
	[Parameter] public bool Visible { get; set; } = true;
	private string GetFieldName(string field) => Prefix == string.Empty ? field : $"{Prefix}.{field}";
}
