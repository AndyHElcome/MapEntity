	<DxGridDataColumn FieldName=@GetFieldName(nameof(SourceTecDocPC.Token_Model)) Caption="Model" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(SourceTecDocPC.Token_Type)) Caption="Type" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(SourceTecDocPC.SalesDesc)) Caption="SalesDesc" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(SourceTecDocPC.ModelGeneration)) Caption="ModelGeneration" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(SourceTecDocPC.TypeDesc)) Caption="TypeDesc" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(SourceTecDocPC.DateRange)) Caption="Dates" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(SourceTecDocPC.KW)) Caption="KW" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(SourceTecDocPC.PS)) Caption="PS" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(SourceTecDocPC.Calc_BHP)) Caption="BHP" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(SourceTecDocPC.Litre)) Caption="Litre" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(SourceTecDocPC.Cyl)) Caption="Cyl" />
	<DxGridDataColumn FieldName=@GetFieldName(nameof(SourceTecDocPC.Calc_Valve)) Caption="Valve" />
