@rendermode InteractiveServer

@using DevExpress.Blazor.Internal.Editors
@using DevExpress.Data.Filtering
@using MMIv8_Ktype.Api
@using MMIv8_Ktype.Api.Endpoints
@using MMIv8_Ktype.Api.Requests
@using MMIv8_Ktype.Api.Responses
@using MMIv8_Ktype.MappingTool.Components.DataGrids.Columns
@using MMIv8_Ktype.MappingTool.Components.Pagers
@using MMIv8_Ktype.Models.Collections
@using System.Linq.Expressions
@using MMIv8_Ktype.Models.Status
@using MMIv8_Ktype.Models.Util



<Generic_Grid @ref="@ImpGrid"
	TItem="MatchBase"
			  Tid="string"
			  TFilter="MatchBaseFilterRequest"
			  TSort="SortQuery<MatchBase>"
			  TEndpoint="IMatchBaseEndpoints"
			  Filter="@Filter"
			  Sort="@Sort"
			  CustomizeElement="Grid_CustomizeElement"
			  ShowPager="@ShowPager"
			  ManualData="@ManualData">
	<Columns>
		<MatchBase_Columns ShowMatchContexts="@ShowMatchContexts" ShowOverriden="@ShowOverriden" />
	</Columns>
	<DetailRows Context="dcontext"  >

		@if (((MMIv8_Ktype.Models.Collections.MatchBase?)dcontext?.DataItem)?.MatchContexts is null || ((MMIv8_Ktype.Models.Collections.MatchBase)dcontext.DataItem).MatchContexts.Count == 0)
		{
			<text>No Match Contexts</text>
		}
		else
		{
			<DxGrid Data="@(((MMIv8_Ktype.Models.Collections.MatchBase)dcontext.DataItem).MatchContexts)"
					FooterDisplayMode="GridFooterDisplayMode.Never"
					ColumnResizeMode="GridColumnResizeMode.NextColumn"
					ShowAllRows="true"
					AllowSort="false">
				<Columns>
					<MatchContext_Columns />
				</Columns>
			</DxGrid>
		}
	</DetailRows>
	<Toolbar>
		<DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Contained">
			<Items>
				<DxToolbarItem BeginGroup="true" Alignment="ToolbarItemAlignment.Left">
					<Template Context="toolbar_item_context">
						<DxDropDownBox Value="@Filter.MatchBaseType"
									   QueryDisplayText="QueryTextFromList<MatchBaseType>"
									   DropDownWidthMode="DropDownWidthMode.EditorWidth"
									   NullText="Select MatchBaseTypes"
									   InputId="ddbMatchBaseType">
							<DropDownBodyTemplate>
								<DxListBox Data="@MatchBaseTypes"
										   TData="MatchBaseType"
										   TValue="MatchBaseType"
										   SelectionMode="ListBoxSelectionMode.Multiple"
										   ShowCheckboxes="true"
										   ValuesChanged="@(SelectChange)"
										   Values="@Filter.MatchBaseType">
								</DxListBox>
							</DropDownBodyTemplate>
						</DxDropDownBox>
					</Template>
				</DxToolbarItem>
				<DxToolbarItem BeginGroup="true" Alignment="ToolbarItemAlignment.Left">
					<Template Context="toolbar_item_context">
						<DxDropDownBox Value="@Filter.Status"
									   QueryDisplayText="QueryTextFromList<Status>"
									   DropDownWidthMode="DropDownWidthMode.EditorWidth"
									   NullText="Select Statuses"
									   InputId="ddbStatus">
							<DropDownBodyTemplate>
								<DxListBox Data="@Statuses"
										   TData="Status"
										   TValue="Status"
										   TextFieldName="@nameof(Status)"
										   SelectionMode="ListBoxSelectionMode.Multiple"
										   ShowCheckboxes="true"
										   ValuesChanged="@(SelectChange)"
										   Values="@Filter.Status">
								</DxListBox>
							</DropDownBodyTemplate>
						</DxDropDownBox>
					</Template>
				</DxToolbarItem>
				<DxToolbarItem BeginGroup="true" Alignment="ToolbarItemAlignment.Left" Visible="false">
					<Template Context="toolbar_item_context">
						<DxDropDownBox Value="@Filter.MatchBaseMethod"
									   QueryDisplayText="QueryTextFromList<MatchBaseMethod>"
									   DropDownWidthMode="DropDownWidthMode.EditorWidth"
									   NullText="Select MatchBaseMethods"
									   InputId="ddbStatus">
							<DropDownBodyTemplate>
								<DxListBox Data="@MatchBaseMethods"
										   TData="MatchBaseMethod"
										   TValue="MatchBaseMethod"
										   TextFieldName="@nameof(MatchBaseMethod)"
										   SelectionMode="ListBoxSelectionMode.Multiple"
										   ShowCheckboxes="true"
										   ValuesChanged="@(SelectChange)"
										   Values="@Filter.MatchBaseMethod">
								</DxListBox>
							</DropDownBodyTemplate>
						</DxDropDownBox>
					</Template>
				</DxToolbarItem>
				<DxToolbarItem Text="Clear Selection" Click="ClearSelection" BeginGroup="true" />
			</Items>
		</DxToolbar> 
	</Toolbar>
</Generic_Grid>

@code {
	Generic_Grid<MatchBase, string, MatchBaseFilterRequest, SortQuery<MatchBase>, IMatchBaseEndpoints> ImpGrid;
	[Parameter] public MatchBase? SelectedItem { get; set; }
	[Parameter] public EventCallback<MatchBase?> SelectedItemChanged { get; set; }

	public MatchBaseFilterRequest Filter { get; set; } = new();
	public SortQuery<MatchBase> Sort { get; set; } = new();


	[Parameter] public List<MatchBase> ManualData { get; set; } = new();

	[Parameter] public bool ShowPager { get; set; } = true;

	[Parameter] public bool ShowOverriden { get; set; } = false;
	[Parameter] public bool ShowMatchContexts { get; set; } = true;

	[Parameter] public GridSelectionMode GridSelectionMode { get; set; } = GridSelectionMode.Single;
	[Parameter] public Expression<Func<MatchBase, bool>>? SelectionPredicate { get; set; }

	MatchBaseType[] MatchBaseTypes = Enum.GetValues<MatchBaseType>();

	Status[] Statuses = Enum.GetValues<Status>();

	MatchBaseMethod[] MatchBaseMethods = Enum.GetValues<MatchBaseMethod>();

	string? QueryTextFromList<T>(DropDownBoxQueryDisplayTextContext? arg)
	{
		var names = (arg?.Value as IEnumerable<T>);
		return names != null && names.Count() > 0 ? string.Join(", ", names) : null;
	}

	void SelectChange<T>(IEnumerable<T> args)
	{
		if (args is IEnumerable<MatchBaseType> matchBaseTypes)
			Filter.MatchBaseType = args.Count() == 0 ? null : matchBaseTypes.ToArray();

		if (args is IEnumerable<Status> statuses)
			Filter.Status = args.Count() == 0 ? null : statuses.ToArray();

		if (args is IEnumerable<MatchBaseMethod> matchBaseMethods)
			Filter.MatchBaseMethod = args.Count() == 0 ? null : matchBaseMethods.ToArray();
	}

	void ClearSelection(ToolbarItemClickEventArgs args)
	{
		Filter.MatchBaseType = null;
		Filter.Status = null;
		Filter.MatchBaseMethod = null;
	}


	void Grid_CustomizeElement(GridCustomizeElementEventArgs e)
	{
		if (e.ElementType == GridElementType.DataRow && (decimal)e.Grid.GetRowValue(e.VisibleIndex, "Score") == 0)
		{
			e.CssClass = "highlighted-item";
		}
	}


}

