@using DevExpress.Blazor.Internal.Editors
@using DevExpress.Data.Filtering
@using MMIv8_Ktype.Api
@using MMIv8_Ktype.Api.Endpoints
@using MMIv8_Ktype.Api.Requests
@using MMIv8_Ktype.Api.Responses
@using MMIv8_Ktype.MappingTool.Components.Pagers
@using MMIv8_Ktype.Models
@using MMIv8_Ktype.Models.Collections
@using System.Linq.Expressions
@using MMIv8_Ktype.Models.Status
@typeparam TItem where TItem : class, ICollectionEntity<Tid>
@typeparam Tid
@typeparam TFilter where TFilter : FilterQuery<TItem>, new()
@typeparam TSort where TSort : SortQuery<TItem>, new()
@typeparam TEndpoint where TEndpoint : class, IEndpoint, IBaseEndpoint<TItem, Tid, TFilter, TSort>


<style>
	.grid-container {
		width: 100%;
	}
	

    .hide-toolbar .dxbl-grid-toolbar-container {
        display: none;
    }


</style>

<div class="grid-container">
	<DxLoadingPanel Visible="@loading"
					IsContentBlocked="true"
					ApplyBackgroundShading="true"
					IndicatorAreaVisible="false"
					Text="Fetching Data...">

		<DxGrid @ref="@GGrid"
			
				Data="@(Response?.Value?.Documents ?? [])"
				FooterDisplayMode="GridFooterDisplayMode.Never"
				ColumnResizeMode="GridColumnResizeMode.NextColumn"
				CssClass="@(showToolbar ? null : "hide-toolbar" )"
				ShowAllRows="true"
				AllowSort="false"
				SelectedDataItem="@SelectedItem"
				SelectedDataItemChanged="@OnSelectedDataItemChanged"
				SelectedDataItems="@selectedDataItems"
				SelectionMode="@GridSelectionMode"
				CustomizeElement="CustomizeElement"
				AllowSelectRowByClick="true"
				TextWrapEnabled="false"
				DetailExpandButtonDisplayMode="@(DetailRows is null ? GridDetailExpandButtonDisplayMode.Never : GridDetailExpandButtonDisplayMode.Auto)"
				ShowGroupedColumns="@(GridCustomizeCellDisplayText is not null)"
				CustomizeCellDisplayText="GridCustomizeCellDisplayText">
			<Columns>
				@Columns
			</Columns>
			<DetailRowTemplate Context="dataContext">
				@if (DetailRows is not null)
				{
					@DetailRows(dataContext)
				}
			</DetailRowTemplate>
		

			<ToolbarTemplate>
				@if (showToolbar)
				{
					@Toolbar
				}
			</ToolbarTemplate>
		</DxGrid>
		@if (ShowPager)
		{
			<PagedCursorResponse_Pager Response="@(Response?.Value)"
									   OnPageChanged="OnPageIndexChanged"
									   OnPageSizeChanged="OnPageSizeChanged"
									   ShowPageSizeSelector="@ShowPageSizeSelector"
									   ShowSummary="true"
									   IsLoading="@(loading || isError)" />
		}


		@if (isError)
		{
			<div class="alert alert-danger m-0" role="alert">
				An error occurred while fetching data. @Response?.Error?.ToString()
			</div>
		}

	</DxLoadingPanel>
</div>

@code {
	public IGrid GGrid { get; set; }
	//TODO Slower when not passed as parameter, might need a preload or change of render mode
	//[Parameter, EditorRequired] public TEndpoint Endpoints { get; set; }
	[Parameter, EditorRequired] public TFilter? Filter { get; set; } = null;
	[Parameter, EditorRequired] public TSort? Sort { get; set; } = null;
	private string? lastFilterHash;
	private string? lastSortHash;

	[Parameter] public EventCallback<Guid> Refresh { get; set; }
	[Parameter] public Guid RefreshGuid { get; set; }
	private Guid? lastRefreshGuid;

	private BasicGetByPageRequest<TItem, TFilter, TSort> GetByPageRequest => new (pagedRequest, Filter, Sort);


	[Parameter] public RenderFragment? Columns { get; set; }
	[Parameter] public RenderFragment<GridDetailRowTemplateContext>? DetailRows { get; set; } = null;
	[Parameter] public RenderFragment? Toolbar { get; set; } = null;
	[Parameter] public bool ShowToolbar { get; set; } = true;
	private bool showToolbar => ShowToolbar && Toolbar is not null;

	[Parameter] public List<TItem>? ManualData { get; set; } = null;
	private List<TItem>? lastManualData { get; set; } = null;

	[Parameter] public int? StartingPageSize { get; set; } 
	[Parameter] public bool ShowPager { get; set; } = true;
	[Parameter] public bool ShowPageSizeSelector { get; set; } = true;

	[Parameter] public GridSelectionMode GridSelectionMode { get; set; } = GridSelectionMode.Single;

	[Parameter]	public Action<GridCustomizeCellDisplayTextEventArgs> GridCustomizeCellDisplayText {get; set; }

	#region Manual Selection

	[Parameter] public TItem? SelectedItem { get; set; }
	[Parameter] public EventCallback<TItem?> SelectedItemChanged { get; set; }


	void OnSelectedDataItemChanged(object newSelection)
	{
		SelectedItem = (TItem?)newSelection;
		SelectedItemChanged.InvokeAsync(SelectedItem);
	}

	#endregion

	#region Multiple Selection
	private IReadOnlyList<object> selectedDataItems { get; set; } = new List<object>();

	[Parameter] public Expression<Func<TItem, bool>>? SelectionPredicate { get; set; } = null;

	public IEnumerable<object> ApplySelection(IEnumerable<TItem> source)
		=> SelectionPredicate is null ? new List<object>() : source.AsQueryable().Where(SelectionPredicate);



	#endregion


	[Parameter] public TEndpoint Endpoints { get; set; } = new RefitClient(Log.Logger).CreateService<TEndpoint>();
	public Models.SerializableResult<PagedResponse<TItem>>? Response { get; set; }
	public bool loading { get; set; } = true;
	public bool isError { get; set; } = false;

	PagedRequest pagedRequest { get; set; } = new();


	protected override async Task OnParametersSetAsync()
	{

		if (loading)
			return;

		string? currentFilterHash = Filter.GetCacheKey() ?? null;
		string? currentSortHash = Sort.GetCacheKey() ?? null;



		bool checkManualData = (lastManualData ?? []).SequenceEqual(ManualData ?? []);

		if (currentFilterHash != lastFilterHash || currentSortHash != lastSortHash || !checkManualData || lastRefreshGuid != RefreshGuid)
		{
			lastFilterHash = currentFilterHash;
			lastSortHash = currentSortHash;
			lastManualData = ManualData;
			lastRefreshGuid = RefreshGuid;
			await LoadData();
			await Refresh.InvokeAsync(RefreshGuid);
		}
	}

	public async Task LoadData()
	{
		try
		{
			loading = true;

			if (ManualData is not null && ManualData.Count > 0)
			{
				ShowPager = false;
				Response = Result.Success(new PagedResponse<TItem>(ManualData, ManualData.Count, 1, ManualData.Count));
				isError = false;
				loading = false;
				StateHasChanged();
				GGrid.AutoFitColumnWidths();
				return;
			}

			Response = await Endpoints.GetByPage(GetByPageRequest);

			if (Response is not null)
			{
				isError = !Response.IsSuccess;
				pagedRequest = new(Response.Value?.CurrentPage, Response.Value?.PageSize);

				selectedDataItems = ApplySelection(Response?.Value?.Documents!).ToList();
			}


		}
		catch (Exception ex)
		{
			isError = true;
			Console.WriteLine(ex);
		}
		finally
		{
			loading = false;
		}
		
		StateHasChanged();
		GGrid.AutoFitColumnWidths();

	}

	async Task OnPageIndexChanged(int newPageIndex)
	{
		pagedRequest = new(newPageIndex, Response?.Value?.PageSize);
		await LoadData();
	}

	async Task OnPageSizeChanged(int newPageSize)
	{
		pagedRequest = new(1, newPageSize);
		await LoadData();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			if (StartingPageSize.HasValue)
			{
				pagedRequest = new(1, StartingPageSize.Value);
			}
			await LoadData();
		}
	}

	[Parameter] public Action<GridCustomizeElementEventArgs>? CustomizeElement { get; set; }



}

