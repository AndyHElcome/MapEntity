
@rendermode InteractiveServer
@page "/admin"
@using MMIv8_Ktype.MappingTool.Components.DataGrids
<h3>Admin</h3>


<style>
    .tabbed-content{
        display: grid; 
        grid-template-columns: auto 1fr;
        grid-auto-rows: auto;
		column-gap: 2rem;
    }

</style>

<div class="tabbed-content">
    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex" TabsPosition="TabsPosition.Left" RenderMode="TabsRenderMode.OnDemand" SizeMode="SizeMode.Large">
        <DxTab Text="Versions" TabIconCssClass="bi bi-archive"></DxTab>
        <DxTab Text="Users" TabIconCssClass="bi bi-people"></DxTab>
    </DxTabs>
    @switch (ActiveTabIndex)
    {
        case 0:
            <Version_Grid />
            break;
        case 1:
            <User_Grid />
            break;
    }
</div>

@code {
    int ActiveTabIndex { get; set; } = 0;
}
